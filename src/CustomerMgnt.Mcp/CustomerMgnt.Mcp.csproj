<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CustomerMgnt.Mcp: MCP server แบบ stdio สำหรับ Claude Desktop / VS Code / Copilot ฯลฯ บนเครื่องผู้ใช้
    ใช้ business layer และ AI tools ชุดเดียวกับ Web API (CustomerMgnt.Core + CustomerMgnt.AI)
    stdout สงวนไว้สำหรับ JSON-RPC เท่านั้น — log ทั้งหมดไป stderr
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CustomerMgnt.Mcp</RootNamespace>
    <UserSecretsId>customermgnt-mcp-8e41b0d3</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CustomerMgnt.Core\CustomerMgnt.Core.csproj" />
    <ProjectReference Include="..\CustomerMgnt.Data\CustomerMgnt.Data.csproj" />
    <ProjectReference Include="..\CustomerMgnt.Integrations\CustomerMgnt.Integrations.csproj" />
    <ProjectReference Include="..\CustomerMgnt.AI\CustomerMgnt.AI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
