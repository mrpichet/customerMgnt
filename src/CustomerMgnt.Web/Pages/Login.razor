@inject AuthState Auth

@* หน้าเข้าสู่ระบบ (ส่งต่อไป AuthServer ผ่าน /api/session/login) *@
<div class="login card">
    <h1>เข้าสู่ระบบ</h1>
    <ErrorBanner Message="@_error" />
    <DxFormLayout>
        <DxFormLayoutItem Caption="ชื่อผู้ใช้" ColSpanMd="12">
            <DxTextBox @bind-Text="_login" InputId="login" />
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="รหัสผ่าน" ColSpanMd="12">
            <DxTextBox @bind-Text="_password" Password="true" />
        </DxFormLayoutItem>
        @if (_mfa)
        {
            <DxFormLayoutItem Caption="รหัส OTP (6 หลัก)" ColSpanMd="12">
                <DxTextBox @bind-Text="_otp" InputId="otp" />
            </DxFormLayoutItem>
        }
        <DxFormLayoutItem ColSpanMd="12">
            <DxButton Text="เข้าสู่ระบบ" Enabled="@(!_busy)" Click="SubmitAsync" RenderStyle="ButtonRenderStyle.Primary" />
        </DxFormLayoutItem>
    </DxFormLayout>
</div>

@code {
    private string _login = "";
    private string _password = "";
    private string _otp = "";
    private string? _error;
    private bool _busy;
    private bool _mfa;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_login) || string.IsNullOrEmpty(_password))
        {
            _error = "กรุณากรอกชื่อผู้ใช้และรหัสผ่าน";
            return;
        }

        if (_mfa && string.IsNullOrWhiteSpace(_otp))
        {
            _error = "กรุณากรอกรหัส OTP";
            return;
        }

        _busy = true;
        LoginResult result = await Auth.LoginAsync(_login.Trim(), _password, _mfa ? _otp.Trim() : null);
        _error = result.Error;
        _mfa = result.MfaRequired;
        _otp = "";
        if (!_mfa)
        {
            _password = ""; // ขั้น OTP ต้องส่งรหัสผ่านเดิมซ้ำ จึงล้างเมื่อจบขั้นตอนเท่านั้น
        }

        _busy = false;
    }
}
