@page "/approvals"
@attribute [Authorize]
@inherits MembershipPage
@* A30 รายการรออนุมัติ (แสดงเฉพาะเรื่องที่ผู้ใช้มีสิทธิ์อนุมัติ หรือที่ตนยื่น) *@
<PageTitle>รายการรออนุมัติ</PageTitle>

<ListTemplate TItem="ApprovalRequestDTO" Title="รายการอนุมัติ" Description="แสดงคำขอที่คุณมีสิทธิ์อนุมัติ และคำขอที่คุณยื่นเอง ผู้ยื่นอนุมัติคำขอของตนเองไม่ได้"
              Breadcrumbs="_crumbs" Permissions="_perms" Items="_items" Loading="_loading" ErrorMessage="@LoadError" OnRetry="LoadAsync"
              CriteriaActiveCount="ActiveCount" OnSearch="LoadAsync" OnClear="ClearAsync" PageSize="20"
              OnView="@(a => Nav.NavigateTo($"approvals/{a.Id}"))">
    <Criteria>
        <Field Label="สถานะ" InputId="c-st">
            <select id="c-st" @bind="_c.Status">
                <option value="">ทั้งหมด</option>
                @foreach (MApprovalStatus s in Enum.GetValues<MApprovalStatus>()) { <option value="@s">@Text.Approval(s)</option> }
            </select>
        </Field>
        <Field Label="ประเภท" InputId="c-tp">
            <select id="c-tp" @bind="_c.Type">
                <option value="">ทั้งหมด</option>
                @foreach (ApprovalType t in Enum.GetValues<ApprovalType>()) { <option value="@t">@Text.ApprovalType(t)</option> }
            </select>
        </Field>
        <Field Label="เฉพาะที่ฉันยื่น" InputId="c-mine"><input id="c-mine" type="checkbox" @bind="_c.Mine" /></Field>
    </Criteria>
    <Columns>
        <TableColumn TItem="ApprovalRequestDTO" Title="ยื่นเมื่อ" Field="a => Text.DateTime(a.RequestedAt)" SortBy="a => a.RequestedAt" Sortable />
        <TableColumn TItem="ApprovalRequestDTO" Title="ประเภท" Field="a => Text.ApprovalType(a.Type)" />
        <TableColumn TItem="ApprovalRequestDTO" Title="เรื่อง" Field="a => a.Summary" IsPrimary />
        <TableColumn TItem="ApprovalRequestDTO" Title="ผู้ยื่น" Field="a => a.RequestedByName ?? a.RequestedBy" HideOnMobile />
        <TableColumn TItem="ApprovalRequestDTO" Title="ขั้น" Field="a => Levels(a)" HideOnMobile />
        <TableColumn TItem="ApprovalRequestDTO" Title="สถานะ" SortBy="a => a.Status">
            <Template><Badge Text="@Text.Approval(context.Status)" Level="@Text.Level(context.Status)" /></Template>
        </TableColumn>
    </Columns>
</ListTemplate>

@code {
    private readonly IReadOnlyList<Breadcrumb> _crumbs = [new("หน้าแรก", ""), new("รายการอนุมัติ")];
    private readonly ListPermissions _perms = new();
    private ApprovalSearchCriteria _c = new() { Status = MApprovalStatus.Pending };
    private IReadOnlyList<ApprovalRequestDTO>? _items;
    private bool _loading;

    private int ActiveCount => (_c.Status is null ? 0 : 1) + (_c.Type is null ? 0 : 1) + (_c.Mine ? 1 : 0);

    private static string Levels(ApprovalRequestDTO a) => $"{a.LevelsApproved}/{a.LevelsRequired}";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        await LoadSafeAsync(async () => _items = await Api.GetAsync<List<ApprovalRequestDTO>>("api/v1/approvals", new { _c.Status, _c.Type, _c.Mine }));
        _loading = false;
    }

    private Task ClearAsync()
    {
        _c = new ApprovalSearchCriteria();
        return LoadAsync();
    }
}
