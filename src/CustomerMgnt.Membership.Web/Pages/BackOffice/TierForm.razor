@page "/tiers/new"
@page "/tiers/{Id:long}/edit"
@attribute [Authorize]
@inherits MembershipPage
@* A11 เพิ่ม/แก้ไข Tier *@
<PageTitle>@Title</PageTitle>

<RequirePermission Permission="@P.TierManage">
    @if (LoadError is not null)
    {
        <ErrorView Title="โหลดข้อมูลไม่สำเร็จ" Message="@LoadError" OnRetry="LoadAsync" />
    }
    else if (_req is null)
    {
        <LoadingState />
    }
    else
    {
        <FormTemplate Title="@Title" Description="ยอดเลื่อนขั้น = ยอดซื้อสุทธิในรอบที่ทำให้ได้ระดับนี้ ยอดคงระดับ = ยอดขั้นต่ำเพื่อไม่ถูกลดระดับเมื่อครบรอบ"
                      Breadcrumbs="Crumbs" Mode="@(Id is null ? FormMode.New : FormMode.Edit)" Model="_req" SavePermission="@P.TierManage" OnSave="SaveAsync" OnCancel="Back">
            <ChildContent>
                <FormSection Title="ข้อมูล Tier">
                    <FieldGrid Columns="2">
                        <FormField Label="รหัส" InputId="code" For="() => _req.Code" Required Hint="เปลี่ยนไม่ได้หลังสร้าง"><InputText id="code" @bind-Value="_req.Code" maxlength="20" disabled="@(Id is not null)" /></FormField>
                        <FormField Label="ชื่อ" InputId="name" For="() => _req.Name" Required><InputText id="name" @bind-Value="_req.Name" maxlength="100" /></FormField>
                        <FormField Label="ลำดับ (ต่ำ → สูง)" InputId="rank" For="() => _req.Rank" Required><InputNumber id="rank" @bind-Value="_req.Rank" min="0" /></FormField>
                        <FormField Label="ตัวคูณคะแนน" InputId="mul" For="() => _req.PointMultiplier" Required><InputNumber id="mul" @bind-Value="_req.PointMultiplier" step="0.01" min="0" /></FormField>
                        <FormField Label="ยอดเลื่อนขั้น (บาท)" InputId="up" For="() => _req.UpgradeThreshold" Required><InputNumber id="up" @bind-Value="_req.UpgradeThreshold" step="0.01" min="0" /></FormField>
                        <FormField Label="ยอดคงระดับ (บาท)" InputId="ret" For="() => _req.RetainThreshold" Required><InputNumber id="ret" @bind-Value="_req.RetainThreshold" step="0.01" min="0" /></FormField>
                    </FieldGrid>
                    <Field Label="สิทธิประโยชน์ (บรรทัดละ 1 ข้อ)" InputId="ben"><textarea id="ben" @bind="_benefits" rows="4" maxlength="2000"></textarea></Field>
                    <label class="check-list"><InputCheckbox @bind-Value="_req.IsActive" /> ใช้งาน</label>
                </FormSection>
            </ChildContent>
        </FormTemplate>
    }
</RequirePermission>

@code {
    [Parameter] public long? Id { get; set; }

    private TierRequest? _req;
    private string? _benefits;

    private string Title => Id is null ? "เพิ่ม Tier" : $"แก้ไข Tier {_req?.Name}";
    private IReadOnlyList<Breadcrumb> Crumbs => [new("หน้าแรก", ""), new("ระดับสมาชิก", "tiers"), new(Title)];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private Task LoadAsync() => LoadSafeAsync(async () =>
    {
        if (Id is null)
        {
            _req = new TierRequest();
            return;
        }

        TierDTO t = await Api.GetAsync<TierDTO>($"api/v1/tiers/{Id}");
        _req = new TierRequest { Code = t.Code, Name = t.Name, Rank = t.Rank, UpgradeThreshold = t.UpgradeThreshold, RetainThreshold = t.RetainThreshold, PointMultiplier = t.PointMultiplier, Benefits = t.Benefits, IsActive = t.IsActive, Version = t.Version };
        _benefits = string.Join('\n', t.Benefits);
    });

    private Task<bool> SaveAsync()
    {
        _req!.Benefits = [.. (_benefits ?? string.Empty).Split('\n').Select(b => b.Trim()).Where(b => b.Length > 0)];
        return SaveSafeAsync(async () =>
        {
            if (Id is null) await Api.PostAsync<TierDTO>("api/v1/tiers", _req);
            else await Api.PutAsync<TierDTO>($"api/v1/tiers/{Id}", _req);
        }, "บันทึก Tier แล้ว", "tiers");
    }

    private void Back() => Nav.NavigateTo("tiers");
}
