@page "/analytics/data-status"
@attribute [Authorize]
@inherits MembershipPage
@* AN-26 สถานะข้อมูล (ANA-ADMIN-002/003) — ความสดของ read model, แหล่งข้อมูลที่ส่งเข้า, ข้อมูลผิดปกติ, สั่งคำนวณใหม่ (ต้องมี ana.settings.manage) *@
<PageTitle>สถานะข้อมูลวิเคราะห์</PageTitle>

<RequirePermission Permission="@A.DashboardRead">
    <PageHeader Title="สถานะข้อมูล" Description="ความสดของข้อมูลที่ใช้ในหน้าวิเคราะห์ แหล่งข้อมูลที่ส่งเข้ามา และข้อมูลที่ระบบรับไม่ได้" Breadcrumbs="_crumbs">
        <Actions><AppButton Text="รีเฟรช" Variant="ButtonVariant.Secondary" OnClick="LoadAsync" /></Actions>
    </PageHeader>
    @if (LoadError is not null) { <ErrorView Title="โหลดข้อมูลไม่สำเร็จ" Message="@LoadError" OnRetry="LoadAsync" /> }
    else if (_s is null) { <LoadingState /> }
    else
    {
        <Card Title="ข้อมูลสำหรับวิเคราะห์">
            <div style="overflow-x:auto">
                <table class="simple-table">
                    <thead><tr><th>ชุดข้อมูล</th><th>ปรับปรุงล่าสุด</th><th>ผล</th><th>ข้อมูลถึง</th><th class="num">ล่าช้า (นาที)</th><th class="num">วันที่รอคำนวณ</th><th>รอบถัดไป</th></tr></thead>
                    <tbody>
                        @foreach (TableStatusDTO t in _s.Tables)
                        {
                            <tr>
                                <td>@AnaText.Table(t.Table)</td><td>@Text.DateTime(t.LastRunAt)</td>
                                <td>@if (t.LastStatus is JobStatus js) { <Badge Text="@Text.Job(js)" Level="@Text.Level(js)" /> } else { <span class="muted">ยังไม่เคย</span> }
                                    @if (t.Error is not null) { <div class="small muted">@t.Error</div> }</td>
                                <td>@Text.DateTime(t.Watermark)</td><td class="num">@AnaText.Int(t.LagMinutes)</td><td class="num">@AnaText.Int(t.DirtyDays)</td><td>@Text.DateTime(t.NextRunAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Card>
        <Card Title="แหล่งข้อมูลที่ส่งเข้า (24 ชั่วโมงล่าสุด)">
            <table class="simple-table">
                <thead><tr><th>ชนิดข้อมูล</th><th>ระบบที่ส่ง</th><th>รับล่าสุด</th><th class="num">รับ</th><th class="num">ปฏิเสธ</th></tr></thead>
                <tbody>
                    @foreach (SourceStatusDTO x in _s.Sources)
                    {
                        <tr><td>@x.Source</td><td>@x.ClientId</td><td>@Text.DateTime(x.LastReceivedAt)</td><td class="num">@AnaText.Int(x.Last24h)</td><td class="num @(x.Rejected24h > 0 ? "ana-down" : null)">@AnaText.Int(x.Rejected24h)</td></tr>
                    }
                    @if (_s.Sources.Count == 0) { <tr><td colspan="5" class="muted">ยังไม่มีข้อมูลส่งเข้า</td></tr> }
                </tbody>
            </table>
        </Card>
        <Card Title="@($"ข้อมูลที่รับไม่ได้ ({AnaText.Int(_s.OpenIssues)} รายการ)")">
            @if (_issues is null || _issues.Items.Count == 0) { <EmptyState Title="ไม่มีข้อมูลผิดปกติ" /> }
            else
            {
                <table class="simple-table">
                    <thead><tr><th>ชนิด</th><th>รหัส</th><th class="num">จำนวนครั้ง</th><th>พบครั้งแรก</th><th>พบล่าสุด</th><th>ตัวอย่าง</th></tr></thead>
                    <tbody>
                        @foreach (DataIssueDTO i in _issues.Items)
                        {
                            <tr><td>@IssueKind(i.Kind)</td><td>@i.Key</td><td class="num">@AnaText.Int(i.Count)</td><td>@Text.DateTime(i.FirstSeen)</td><td>@Text.DateTime(i.LastSeen)</td><td class="small"><code>@Short(i.SampleJson)</code></td></tr>
                        }
                    </tbody>
                </table>
                <div class="row-actions">
                    <AppButton Text="ก่อนหน้า" Disabled="@(_issues.Page <= 1)" OnClick="() => IssuesAsync(_issues.Page - 1)" />
                    <span class="muted">หน้า @_issues.Page / @Math.Max(1, (_issues.Total + _issues.PageSize - 1) / _issues.PageSize)</span>
                    <AppButton Text="ถัดไป" Disabled="@((long)_issues.Page * _issues.PageSize >= _issues.Total)" OnClick="() => IssuesAsync(_issues.Page + 1)" />
                </div>
            }
        </Card>
        <PermissionView Permission="@A.SettingsManage">
            <Card Title="สั่งคำนวณข้อมูลใหม่">
                <p class="small">ใช้เมื่อแก้ไขข้อมูลต้นทางย้อนหลัง ระบบคำนวณเบื้องหลังทีละคำขอ ช่วงวันที่ทับกับคำขอที่ยังไม่เสร็จจะถูกปฏิเสธ</p>
                <FieldGrid Columns="3">
                    <Field Label="ชุดข้อมูล" InputId="rt">
                        <div class="check-list">
                            @foreach (string t in AnaTablesText.All)
                            {
                                <label><input type="checkbox" checked="@_tables.Contains(t)" @onchange="e => { if (e.Value is true) _tables.Add(t); else _tables.Remove(t); }" /> @AnaText.Table(t)</label>
                            }
                        </div>
                    </Field>
                    <Field Label="จากวันที่" InputId="rf"><input id="rf" type="date" @bind="_from" /></Field>
                    <Field Label="ถึงวันที่" InputId="rto"><input id="rto" type="date" @bind="_to" /></Field>
                </FieldGrid>
                <AppButton Text="สั่งคำนวณใหม่" Variant="ButtonVariant.Primary" Busy="Busy" Disabled="@(_tables.Count == 0 || _from is null || _to is null)" OnClick="RefreshAsync" />
            </Card>
        </PermissionView>
        <Card Title="คำขอคำนวณใหม่ล่าสุด">
            <table class="simple-table">
                <thead><tr><th>ขอเมื่อ</th><th>ชุดข้อมูล</th><th>ช่วงวันที่</th><th>ผู้ขอ</th><th>สถานะ</th><th>เสร็จเมื่อ</th></tr></thead>
                <tbody>
                    @foreach (RefreshRunDTO r in _runs ?? [])
                    {
                        <tr>
                            <td>@Text.DateTime(r.RequestedAt)</td><td>@string.Join(", ", r.Tables.Select(AnaText.Table))</td><td>@AnaText.Date(r.From) – @AnaText.Date(r.To)</td><td>@r.RequestedBy</td>
                            <td><Badge Text="@Text.Job(r.Status)" Level="@Text.Level(r.Status)" />@if (r.Error is not null) { <div class="small muted">@r.Error</div> }</td>
                            <td>@Text.DateTime(r.FinishedAt)</td>
                        </tr>
                    }
                    @if ((_runs?.Count ?? 0) == 0) { <tr><td colspan="6" class="muted">ไม่มีคำขอ</td></tr> }
                </tbody>
            </table>
        </Card>
    }
</RequirePermission>

@code {
    private readonly IReadOnlyList<Breadcrumb> _crumbs = [new("หน้าแรก", ""), new("วิเคราะห์ข้อมูล", "analytics"), new("สถานะข้อมูล")];
    private readonly HashSet<string> _tables = [AnaTablesText.Sales];
    private DataStatusDTO? _s;
    private PagedResultDTO<DataIssueDTO>? _issues;
    private IReadOnlyList<RefreshRunDTO>? _runs;
    private DateOnly? _from, _to;

    protected override Task OnInitializedAsync()
    {
        DateOnly today = DateOnly.FromDateTime(DateTime.Now);
        _to = today.AddDays(-1);
        _from = today.AddDays(-7);
        return LoadAsync();
    }

    private Task LoadAsync() => LoadSafeAsync(async () =>
    {
        _s = await Api.GetAsync<DataStatusDTO>("api/v1/analytics/admin/data-status");
        _runs = await Api.GetAsync<List<RefreshRunDTO>>("api/v1/analytics/admin/refresh");
        _issues = await Api.GetAsync<PagedResultDTO<DataIssueDTO>>("api/v1/analytics/admin/data-issues?page=1&pageSize=20");
    });

    private Task IssuesAsync(int page) => LoadSafeAsync(async () => _issues = await Api.GetAsync<PagedResultDTO<DataIssueDTO>>($"api/v1/analytics/admin/data-issues?page={page}&pageSize=20"));

    private async Task RefreshAsync()
    {
        if (_from > _to)
        {
            Toasts.Warning("วันที่เริ่มต้องไม่เกินวันที่สิ้นสุด");
            return;
        }

        if (await SaveSafeAsync(() => Api.PostAsync<RefreshRunDTO>("api/v1/analytics/admin/refresh", new RefreshRequest { Tables = [.. _tables], From = _from!.Value, To = _to!.Value }),
            "ส่งคำขอคำนวณใหม่แล้ว (ทำงานเบื้องหลัง)"))
        {
            _runs = await Api.GetAsync<List<RefreshRunDTO>>("api/v1/analytics/admin/refresh");
        }
    }

    // ชนิด = "{แหล่ง}.{ผล}" เช่น products.rejected, message-events.unknown
    private static string IssueKind(string k)
    {
        int i = k.LastIndexOf('.');
        if (i < 0) return k;
        string status = k[(i + 1)..] switch
        {
            "rejected" => "ถูกปฏิเสธ",
            "unknown" => "อ้างถึงข้อมูลที่ไม่รู้จัก",
            "stale" => "เก่ากว่าที่มีอยู่",
            var x => x,
        };
        return $"{k[..i]}: {status}";
    }

    private static string Short(string? json) => json is null ? "-" : json.Length > 120 ? json[..120] + "…" : json;
}
