@inherits LayoutComponentBase
@* หน้าก่อนเข้าสู่ระบบ: Logo มุมซ้ายบน, สลับ Theme มุมขวาบน, การ์ดกลางจอ *@
<div class="auth-layout">
    <header class="auth-layout__top">
        <AppBrand Variant="surface" />
        <ThemeToggle />
    </header>
    <main class="auth-layout__main" id="main-content">
        <div class="auth-layout__card">
            @Body
        </div>
    </main>
    <footer class="auth-layout__footer">
        <span>@App.Value.Organization</span>
        <span>v@(App.Value.Version)</span>
    </footer>
    <ToastHost />
</div>

@code {
    [Inject] private IOptions<AppInfoOptions> App { get; set; } = default!;
}
