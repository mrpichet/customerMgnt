{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "LogServer": {
      "Enabled": true,
      "ServerUrls": "",
      "Source": "customermgnt-api",
      "MinimumLevel": "Information",
      "SpoolDirectory": "/tmp/logserver-spool"
    }
  },
  "AllowedHosts": "*",
  "AuthServer": {
    "Authority": "https://localhost:8443",
    "Audience": "authserver-api",
    "RequireHttpsMetadata": true,
    "UseIntrospection": false
  },
  "Database": {
    "Provider": "Postgres",
    "ConnectionString": "",
    "ApplicationName": "customermgnt-api",
    "RunMigrations": true,
    "InMemory": false
  },
  "Pqc": {
    "Mode": "Preferred",
    "AllowEphemeralKeys": false
  },
  "Privacy": {
    "BlindIndexKey": "",
    "AllowEphemeralKey": false
  },
  "Compute": {
    "UseSimd": true,
    "UseParallel": true,
    "ParallelThreshold": 2048
  },
  "RateLimit": {
    "PermitsPerSecond": 200
  },
  "CustomerMgnt": {
    "CustomerCodePrefix": "CUST-",
    "RequestNoPrefix": "REQ",
    "NegativeSentimentAlertThreshold": -0.35,
    "AgingBucketDays": [ 7, 30, 90 ],
    "ReminderScanSeconds": 60
  },
  "Analytics": {
    "ModelTtlMinutes": 360,
    "MinSamplesPerClass": 15,
    "SegmentCount": 5,
    "MaxCustomersPerRun": 200000,
    "RefreshHours": 24,
    "RefreshInitialDelaySeconds": 120,
    "PersistSegments": true
  },
  "Integrations": {
    "IssueTracking": { "BaseUrl": "", "TimeoutSeconds": 15 },
    "ProjectMgnt": { "BaseUrl": "", "TimeoutSeconds": 15 },
    "RequirementMgnt": { "BaseUrl": "", "TimeoutSeconds": 15 },
    "MessageHub": { "BaseUrl": "", "TimeoutSeconds": 15 },
    "ServiceAccount": { "AuthServerUrl": "", "Login": "", "Password": "" },
    "MaxIssues": 20000
  },
  "Webhooks": {
    "LineChannelSecret": "",
    "InboundSecret": "",
    "MaxClockSkewSeconds": 300
  }
}
